# Hosts the sandboxed opencode container may reach through the gateway proxy.
# One POSIX extended regex per line, matched case-insensitively against the hostname.
# Extra entries can be added in ~/.config/opencode-sandbox/allowlist.

# GitHub Copilot (github.com accounts, including Copilot Enterprise)
^github\.com$
^api\.github\.com$
(^|\.)githubcopilot\.com$
^copilot-proxy\.githubusercontent\.com$
^origin-tracker\.githubusercontent\.com$
^copilot-telemetry\.githubusercontent\.com$

# opencode
(^|\.)opencode\.ai$
^models\.dev$

# Python packages
^pypi\.org$
^files\.pythonhosted\.org$

# uv managed Python downloads (python-build-standalone via GitHub releases)
^objects\.githubusercontent\.com$
^release-assets\.githubusercontent\.com$
(^|\.)astral\.sh$

# pyenv source downloads
^www\.python\.org$
